# Copiez ce fichier en .env et remplacez CHAQUE valeur. Ne versionnez jamais le fichier .env.

# --- Django ---
# En développement, DJANGO_SECRET_KEY et IP_HASH_SALT sont générés automatiquement s'ils
# sont absents ou valent « change-me… ». En production, le démarrage est refusé : générez-les avec
#   python manage.py generate_secret_key --all          (affiche)
#   python manage.py generate_secret_key --all --write  (écrit dans .env)
DJANGO_SECRET_KEY=change-me-par-une-valeur-aleatoire-de-64-caracteres
DJANGO_ALLOWED_HOSTS=votredomaine.tld,www.votredomaine.tld
DJANGO_CSRF_TRUSTED_ORIGINS=https://votredomaine.tld,https://www.votredomaine.tld
SITE_URL=https://votredomaine.tld
DASHBOARD_PREFIX=gestion
# true uniquement derrière un proxy de confiance (Nginx, ou Vercel avec PROXY_SHARED_SECRET)
TRUST_PROXY_HEADERS=true
# En-tête portant l'IP cliente : X-Real-IP (Nginx) ou X-Forwarded-For (Vercel → Render, secret obligatoire)
CLIENT_IP_HEADER=X-Real-IP
# Vercel → Render : secret ajouté par Vercel à chaque requête relayée ; tout appel direct au backend
# est refusé (404). Même valeur dans Vercel. Vide = contrôle désactivé (déploiement Nginx).
PROXY_SHARED_SECRET=
# true si Django doit servir /media/ lui-même (hébergeur sans Nginx, ex. Render)
SERVE_MEDIA=false
DJANGO_LOG_LEVEL=INFO
DJANGO_HSTS_PRELOAD=false
# Restreindre l'administration à certaines IP (facultatif, CIDR séparés par des virgules)
ADMIN_ALLOWED_IPS=
# Sel de pseudonymisation des IP (valeur aléatoire distincte de la clé secrète)
IP_HASH_SALT=change-me-autre-valeur-aleatoire

# --- PostgreSQL ---
POSTGRES_DB=portfolio_v2
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Rôle propriétaire du schéma : utilisé uniquement pour les migrations
POSTGRES_OWNER_USER=portfolio_owner
POSTGRES_OWNER_PASSWORD=change-me-mot-de-passe-proprietaire
# Rôle applicatif : lecture/écriture des données, aucun droit de modifier le schéma
POSTGRES_USER=portfolio_app
POSTGRES_PASSWORD=change-me-mot-de-passe-applicatif

# --- E-mails (notifications de contact et réinitialisation du mot de passe) ---
EMAIL_HOST=smtp.votre-fournisseur.tld
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Portfolio <no-reply@votredomaine.tld>
CONTACT_NOTIFY_EMAIL=vous@votredomaine.tld
PASSWORD_RESET_ENABLED=true

# --- Limitation de débit (valeurs par défaut recommandées) ---
THROTTLE_PUBLIC=120/min
THROTTLE_CONTACT=5/hour
THROTTLE_CONTACT_DAILY=20/day
THROTTLE_LOGIN=10/min
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# --- Sauvegardes (deploy/scripts/backup_db.sh) ---
# Clé publique ou phrase de passe utilisée pour chiffrer les sauvegardes
BACKUP_PASSPHRASE=change-me-phrase-de-chiffrement-des-sauvegardes
BACKUP_RETENTION_DAYS=14

# --- Optionnel ---
# REDIS_URL=redis://redis:6379/0

# Frontend public : sources et dossier publié (pages projet générées, SEO, CSS regroupé).
# FRONTEND_DIR=/chemin/vers/portfolio/frontend
# FRONTEND_BUILD_DIR=/chemin/vers/portfolio/build
